    "capability.unsupported_mihomo %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not available until the remote mihomo-compatible endpoint reports the required capability. Retry Test or Refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要远程 mihomo-compatible 端点报告所需能力后才可用。请重试测试或刷新。"
          }
        }
      }
    },
    "capability.unsupported_nikki %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is available only through Nikki's mihomo-compatible external-controller. Mica will not manage Nikki services, profile mixins, OpenWrt files, or device runtime state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只能通过 Nikki 的 mihomo-compatible external-controller 使用。Mica 不会管理 Nikki 服务、profile mixin、OpenWrt 文件或设备运行状态。"
          }
        }
      }
    },
    "capability.unsupported_openclash %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is available only through OpenClash's already-enabled Clash/mihomo-compatible external-controller. Mica will not use LuCI, SSH, ubus, OpenWrt service restart, or firewall management."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只能通过 OpenClash 已启用的 Clash/mihomo-compatible external-controller 使用。Mica 不会使用 LuCI、SSH、ubus、OpenWrt 服务重启或防火墙管理。"
          }
        }
      }
    },
    "capability.unsupported_profile %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable because this controller profile is marked unsupported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此控制器配置标记为不支持，因此 %@ 不可用。"
          }
        }
      }
    },
    "capability.unsupported_sing_box %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable for sing-box because this build has no sing-box API adapter yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 对 sing-box 不可用，因为此版本尚无 sing-box API 适配器。"
          }
        }
      }
    },
    "capability.unsupported_sing_box_data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data is not available from the sing-box StartedService gRPC API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sing-box StartedService gRPC API 不提供此类数据。"
          }
        }
      }
    },
    "capability.unsupported_smart %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable for the smart probe boundary until Test detects a compatible remote controller. Mica does not download, bundle, or run a local core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在智能探测边界内不可用，直到测试检测到兼容的远程控制器。Mica 不下载、不内置、不运行本地核心。"
          }
        }
      }
    },
    "capability.unsupported_stash_cmfa %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable for Stash / CMFA because this build has no Stash/CMFA API adapter yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 对 Stash / CMFA 不可用，因为此版本尚无 Stash/CMFA API 适配器。"
          }
        }
      }
    },
    "capability.unsupported_surge %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a mihomo-compatible operation, not a Surge HTTP API operation. Use Surge outbound, policy selection, policy test, or active request controls in the Surge workspace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是 mihomo-compatible 操作，不是 Surge HTTP API 操作。请使用 Surge 出站模式、策略选择、策略测试或活跃请求控制。"
          }
        }
      }
    },
    "capability.unsupported_unknown %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable until Test Connection identifies a supported remote controller."
