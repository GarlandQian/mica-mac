    "editor.help_host": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the host or address where the controller HTTP API is enabled. Credentials stay local; copied reports exclude credentials and raw response bodies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入已启用控制器 HTTP API 的主机或地址。凭据保留在本机；复制报告排除凭据和原始响应正文。"
          }
        }
      }
    },
    "editor.help_name": {
      "extractionState": "manual",
