    "surge.operation_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surge support uses the user-enabled Surge HTTP API with X-Key. Mica does not control the local Surge app process, change system proxy settings, install profiles, edit Surge config files, or download Surge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Surge 支持只使用用户启用的 Surge HTTP API 和 X-Key。Mica 不控制本机 Surge 进程，不更改系统代理，不安装配置，不编辑 Surge 配置文件，也不下载 Surge。"
          }
        }
      }
    },
    "surge.platform_evidence_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS control is limited to a user-enabled HTTP API reachable over trusted Wi-Fi or USB networking; cellular reachability is not assumed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 控制仅限用户启用且可通过可信 Wi-Fi 或 USB 网络访问的 HTTP API；不假设蜂窝网络可达。"
          }
        }
      }
    },
    "surge.platform_evidence_mac_local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Local can point at the user-enabled local Surge HTTP API; Mica never changes macOS system proxy settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 Mac 可以指向用户启用的本地 Surge HTTP API；Mica 绝不更改 macOS 系统代理设置。"
          }
        }
      }
    },
    "surge.platform_evidence_remote_mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Mac control requires the user's reachable Surge HTTP API endpoint and X-Key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程 Mac 控制需要用户可访问的 Surge HTTP API 端点和 X-Key。"
          }
        }
      }
    },
