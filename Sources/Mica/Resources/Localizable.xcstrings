    "unified.boundary_mihomo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "mihomo-compatible external-controller operations are available after endpoint probes pass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点探测通过后，可使用 mihomo-compatible external-controller 操作。"
          }
        }
      }
    },
    "unified.boundary_nikki": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikki uses its mihomo-compatible external-controller; OpenWrt runtime, mixin, service, and file management stay outside Mica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikki 只使用 mihomo-compatible external-controller；OpenWrt 运行时、mixin、服务和文件管理不属于 Mica。"
          }
        }
      }
    },
    "unified.boundary_openclash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClash uses its already-enabled Clash/mihomo-compatible external-controller; LuCI, SSH, ubus, service, and firewall management stay outside Mica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClash 只使用已启用的 Clash/mihomo-compatible external-controller；LuCI、SSH、ubus、服务和防火墙管理不属于 Mica。"
          }
        }
      }
    },
    "unified.boundary_sing_box": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sing-box is tracked as a future capability family; no sing-box API operation is wired yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sing-box 作为未来能力族展示；当前尚未接入 sing-box API 操作。"
          }
        }
      }
    },
    "unified.boundary_cmfa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CMFA uses its Clash-compatible remote controller. Cache and memory operations remain available; runtime configuration and core management stay unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CMFA 使用 Clash-compatible 远程控制器；缓存和内存操作可用，运行时配置与核心管理不可用。"
          }
        }
      }
    },
    "unified.boundary_stash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash uses its Clash-compatible remote controller with Stash-specific configuration and capability limits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash 使用 Clash-compatible 远程控制器，并遵循 Stash 特有的配置与能力限制。"
          }
        }
      }
    },
    "unified.boundary_smart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart probing is readiness-only until a compatible remote controller is detected; Mica does not download, bundle, or run a local core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart 探测在识别出兼容远程控制器前只用于就绪度判断；Mica 不会下载、内置或运行本地核心。"
          }
        }
      }
    },
    "unified.boundary_stash_cmfa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved Stash / CMFA hint is resolved to a concrete runtime variant before remote operations are enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的 Stash / CMFA 提示会先解析为具体运行时类型，再启用对应的远程操作。"
          }
        }
      }
    },
    "unified.boundary_surge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surge operations use only the user-enabled HTTP API and X-Key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Surge 操作只使用用户启用的 HTTP API 和 X-Key。"
          }
        }
      }
    },
    "unified.boundary_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run Test Connection to identify the remote controller before enabling operations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先运行连接测试识别远程控制器，再启用操作。"
          }
        }
      }
    },
    "unified.boundary_unsupported": {
      "extractionState": "manual",
