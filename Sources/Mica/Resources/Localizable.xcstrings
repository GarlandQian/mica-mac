            "value": "Core lifecycle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心生命周期"
          }
        }
      }
    },
    "coverage.detail_config_mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode, log level, LAN, IPv6, TUN, TCP concurrent, ports, and mode options when the controller reports them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制器报告时显示模式、日志级别、LAN、IPv6、TUN、TCP 并发连接、端口和模式选项。"
          }
        }
      }
    },
    "coverage.detail_connections": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection id, host, process, source, destination, rule, payload, chain, upload/download, timing, and metadata when the API reports it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示连接 ID、主机、进程、源地址、目标地址、规则、载荷、链路、上传/下载，以及 API 报告的时间和元数据。"
          }
        }
      }
    },
    "coverage.detail_core_lifecycle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote restart or upgrade is shown only for confirmed mihomo-compatible external-controller APIs and never downloads or starts a local core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程重启或升级仅对确认过的 mihomo-compatible external-controller API 显示，绝不下载或启动本地核心。"
          }
        }
      }
    },
    "coverage.detail_dns_cache_geo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS and cache operations appear only when a supported remote controller API exists; Geo resources stay unavailable until a supported contract is wired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在存在受支持远程控制器 API 时显示 DNS 和缓存操作；Geo 资源在接入受支持契约前保持不可用。"
          }
        }
      }
    },
    "coverage.detail_live_logs_traffic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual Live streams or Surge Near Live HTTP refresh expose rates, sample counts, log/event counts, and active/recent request aggregates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动实时观察流或 Surge 近实时 HTTP 刷新显示速率、样本数、日志/事件数和活跃/最近请求聚合。"
          }
        }
      }
    },
    "coverage.detail_memory_aggregates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregate memory usage appears only when a supported remote controller API reports it, without raw debug dumps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在支持的远程控制器 API 报告时显示聚合内存用量，不包含原始调试转储。"
          }
        }
      }
    },
    "coverage.detail_memory_runtime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregate memory, runtime status, or goroutine counts are shown only for supported remote APIs and never include raw debug dumps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对支持的远程 API 显示聚合内存、运行状态或 goroutine 数量，不包含原始调试转储。"
          }
        }
      }
    },
    "coverage.detail_providers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider identity, kind, type, vehicle, item count, updatedAt, update status, and update action where supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示来源标识、类别、类型、载体类型、项目数、更新时间、更新状态，以及支持时的更新操作。"
          }
        }
      }
    },
    "coverage.detail_proxy_groups_nodes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy or policy groups, current node, node count, latency, and availability from the selected controller data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所选控制器数据中的代理/策略组、当前节点、节点数、延迟和可用状态。"
          }
        }
      }
    },
    "coverage.detail_rules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule type, payload, proxy target, size, and fallback or MATCH visibility from the current data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当前数据中的规则类型、载荷、代理目标、大小，以及兜底或 MATCH 标识。"
          }
        }
      }
    },
    "coverage.detail_runtime_goroutine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime status and goroutine-style counts stay unavailable until a remote adapter reports aggregate values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行状态和 goroutine 计数在远程适配器报告聚合值前保持不可用。"
          }
        }
      }
    },
    "coverage.detail_tailscale_status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown as a visible capability boundary until a supported remote backend adapter exposes Tailscale status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持的远程后端适配器暴露 Tailscale 状态前，作为可见能力边界显示。"
